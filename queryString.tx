esercizi querystring con select:

SELECT 
    * 
FROM 
    students
WHERE
    date_of_birth >= '1990/01/01'
    AND date_of_birth <= '1991/01/01';

SELECT 
    * 
FROM 
    courses
WHERE
    cfu >= 10;

SELECT 
    * 
FROM 
    students
WHERE
    DATE(date_of_birth) <= '1996/01/01';

SELECT 
    * 
FROM 
    courses
WHERE
    period = 'I semestre';

SELECT 
    * 
FROM 
    exams
WHERE
    TIME(hour) >= '14:00:00';

SELECT 
    * 
FROM 
    degrees
WHERE
    level = 'magistrale';

SELECT 
    * 
FROM 
    departments
WHERE
    id ORDER BY id DESC; (12 dipartimenti)

SELECT 
    * 
FROM 
    teachers
WHERE
    phone ORDER BY phone = NULL;